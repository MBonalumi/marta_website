---
import ContactForm from '../components/ContactForm.tsx';
---

<section id="contatti" class="py-24 bg-white">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-serif font-bold text-brand-charcoal mb-4">
        Inizia il tuo percorso
      </h2>
      <p class="text-brand-charcoal/70 text-lg leading-relaxed max-w-xl mx-auto">
        Puoi contattarmi via email, telefono o compilando il modulo. Rispondo
        entro 24–48 ore lavorative.
      </p>
    </div>

    <div class="max-w-5xl mx-auto flex flex-col lg:flex-row gap-12 items-start">

      <!-- Left column: contact info (~35%) -->
      <div class="w-full lg:w-[42%] flex flex-col gap-6 shrink-0">

        <a
          href="mailto:martadegani.md@gmail.com"
          class="flex items-center gap-7 p-9 bg-brand-beige/30 rounded-2xl border border-brand-sage/10 hover:shadow-md transition-all group"
        >
          <div class="w-[4.5rem] h-[4.5rem] bg-brand-sage/10 rounded-xl flex items-center justify-center text-brand-sage shrink-0 group-hover:bg-brand-sage group-hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold uppercase tracking-widest text-brand-charcoal/40 mb-2">Email</p>
            <p class="text-brand-sage font-medium text-base leading-snug">martadegani.md@gmail.com</p>
          </div>
        </a>

        <a
          href="tel:+393473919327"
          class="flex items-center gap-7 p-9 bg-brand-beige/30 rounded-2xl border border-brand-sage/10 hover:shadow-md transition-all group"
        >
          <div class="w-[4.5rem] h-[4.5rem] bg-brand-sage/10 rounded-xl flex items-center justify-center text-brand-sage shrink-0 group-hover:bg-brand-sage group-hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold uppercase tracking-widest text-brand-charcoal/40 mb-2">Telefono</p>
            <p class="text-brand-sage font-medium text-base">+39 347 391 9327</p>
          </div>
        </a>

        <div class="flex items-center gap-7 p-9 bg-brand-beige/30 rounded-2xl border border-brand-sage/10">
          <div class="w-[4.5rem] h-[4.5rem] bg-brand-sage/10 rounded-xl flex items-center justify-center text-brand-sage shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold uppercase tracking-widest text-brand-charcoal/40 mb-2">Dove ricevo</p>
            <p class="text-brand-charcoal/70 text-base leading-relaxed">Como<br />Lecco<br />Pasturo (LC)<br />Online</p>
          </div>
        </div>

      </div>

      <!-- Right column: contact form (~65%) -->
      <div class="w-full lg:flex-1 bg-brand-beige/20 rounded-3xl border border-brand-sage/10 p-8 md:p-10">
        <ContactForm client:load />
      </div>

    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "about": {
    "@type": "Physician",
    "name": "Marta Degani"
  },
  "contactOption": [
    {
      "@type": "ContactOption",
      "contactType": "customer service",
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+393473919327",
        "contactType": "customer service",
        "areaServed": ["IT"],
        "availableLanguage": "it"
      }
    },
    {
      "@type": "ContactOption",
      "contactType": "email support",
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "martadegani.md@gmail.com",
        "contactType": "email support",
        "areaServed": ["IT"],
        "availableLanguage": "it"
      }
    }
  ]
}
</script>
